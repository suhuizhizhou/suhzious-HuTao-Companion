<Window x:Class="HuTao.Pet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="胡桃桌宠" Height="560" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize">
    <Grid>
        <Border x:Name="ShellBorder" Background="#F5FFFFFF" CornerRadius="18" BorderBrush="#E0B06A30" BorderThickness="2.5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏（可拖动） -->
                <Border x:Name="TitleBarBorder" Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        Background="#40B06A30" CornerRadius="16,16,0,0" Padding="14,10">
                    <DockPanel>
                        <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="✕" Width="28" Height="28"
                                Click="Close_Click" Background="Transparent" BorderThickness="0"
                                Foreground="#8B4A1F" FontSize="14" Cursor="Hand" ToolTip="关闭"/>
                        <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="🗑" Width="28" Height="28"
                                Click="Clear_Click" Background="Transparent" BorderThickness="0"
                                Foreground="#8B4A1F" FontSize="13" Cursor="Hand" ToolTip="清空聊天记录" Margin="0,0,2,0"/>
                        <Button x:Name="SwitchButton" DockPanel.Dock="Right" Content="⇄" Width="28" Height="28"
                                Click="Switch_Click" Background="Transparent" BorderThickness="0"
                                Foreground="#8B4A1F" FontSize="14" Cursor="Hand" ToolTip="切换角色" Margin="0,0,2,0"/>
                        <Button x:Name="AwarenessButton" DockPanel.Dock="Right" Content="○" Width="28" Height="28"
                                Click="Awareness_Click" Background="Transparent" BorderThickness="0"
                                Foreground="#8B4A1F" FontSize="15" Cursor="Hand"
                                ToolTip="应用状态感知已关闭" Margin="0,0,2,0"/>
                        <TextBlock x:Name="TitleText" Text="🍑 胡桃 · 往生堂堂主" FontWeight="Bold" FontSize="15"
                                   Foreground="#7A3F16" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- 气泡区 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="BubbleScroll" Padding="12,8">
                    <StackPanel x:Name="BubblePanel"/>
                </ScrollViewer>

                <!-- 输入区 -->
                <Border Grid.Row="2" Padding="12,4,12,14">
                    <DockPanel>
                        <Button x:Name="SendButton" DockPanel.Dock="Right" Content="发送" Width="66" Height="34"
                                Click="Send_Click" Background="#E08A3C" Foreground="White"
                                BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                        <TextBox x:Name="InputBox" Height="34" VerticalContentAlignment="Center" BorderThickness="1"
                                 KeyDown="InputBox_KeyDown" Margin="0,0,10,0"
                                 FontSize="14" Padding="8,0"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
