<Window x:Class="HuTao.Pet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="胡桃桌宠" Height="480" Width="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize">
    <Grid>
        <!-- 完整聊天模式。默认尺寸比旧版更小。 -->
        <Grid x:Name="FullModePanel">
            <Border x:Name="ShellBorder" Background="#F5FFFFFF" CornerRadius="18"
                    BorderBrush="#E0B06A30" BorderThickness="2.5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏（可拖动） -->
                    <Border x:Name="TitleBarBorder" Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                            Background="#40B06A30" CornerRadius="16,16,0,0" Padding="10,9">
                        <DockPanel>
                            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="✕" Width="27" Height="28"
                                    Click="Close_Click" Background="Transparent" BorderThickness="0"
                                    Foreground="#8B4A1F" FontSize="14" Cursor="Hand" ToolTip="退出桌宠"/>
                            <Button x:Name="HideButton" DockPanel.Dock="Right" Content="—" Width="27" Height="28"
                                    Click="HideWindow_Click" Background="Transparent" BorderThickness="0"
                                    Foreground="#8B4A1F" FontSize="14" Cursor="Hand" ToolTip="完全隐藏到系统托盘"/>
                            <Button x:Name="CompactButton" DockPanel.Dock="Right" Content="◫" Width="27" Height="28"
                                    Click="CompactMode_Click" Background="Transparent" BorderThickness="0"
                                    Foreground="#8B4A1F" FontSize="14" Cursor="Hand" ToolTip="切换为头像气泡模式"/>
                            <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="🗑" Width="27" Height="28"
                                    Click="Clear_Click" Background="Transparent" BorderThickness="0"
                                    Foreground="#8B4A1F" FontSize="13" Cursor="Hand" ToolTip="清空聊天记录"/>
                            <Button x:Name="SwitchButton" DockPanel.Dock="Right" Content="⇄" Width="28" Height="28"
                                    Click="Switch_Click" Background="Transparent" BorderThickness="0"
                                    Foreground="#8B4A1F" FontSize="15" Cursor="Hand" ToolTip="选择角色"/>
                            <Button x:Name="AwarenessButton" DockPanel.Dock="Right" Content="○" Width="27" Height="28"
                                    Click="Awareness_Click" Background="Transparent" BorderThickness="0"
                                    Foreground="#8B4A1F" FontSize="15" Cursor="Hand"
                                    ToolTip="应用状态感知已关闭"/>
                            <Button x:Name="ReadButton" DockPanel.Dock="Right" Content="📖" Width="28" Height="28"
                                    Click="ReadDocument_Click" Background="Transparent" BorderThickness="0"
                                    Foreground="#8B4A1F" FontSize="14" Cursor="Hand"
                                    ToolTip="选择 TXT/DOCX 生成角色朗读 MP3"/>
                            <Button x:Name="ChatRoomButton" DockPanel.Dock="Right" Content="💬" Width="28" Height="28"
                                    Click="ChatRoom_Click" Background="Transparent" BorderThickness="0"
                                    Foreground="#8B4A1F" FontSize="14" Cursor="Hand"
                                    ToolTip="打开多人聊天室：让几位角色同场闲聊，你旁观或插话"/>
                            <TextBlock x:Name="TitleText" Text="🍑 胡桃" FontWeight="Bold" FontSize="14"
                                       Foreground="#7A3F16" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <!-- 气泡区 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="BubbleScroll" Padding="10,7">
                        <StackPanel x:Name="BubblePanel"/>
                    </ScrollViewer>

                    <!-- 输入区。系统提示走上方 StatusText，绝不混进角色气泡流。 -->
                    <Border Grid.Row="2" Padding="10,4,10,12">
                        <StackPanel>
                            <TextBlock x:Name="StatusText" Visibility="Collapsed"
                                       FontSize="10.5" Foreground="#96755A" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" Margin="2,0,2,4"
                                       ToolTip="系统提示，不属于角色台词"/>
                            <DockPanel>
                                <Button x:Name="SendButton" DockPanel.Dock="Right" Content="发送" Width="62" Height="34"
                                        Click="Send_Click" Background="#E08A3C" Foreground="White"
                                        BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                                <TextBox x:Name="InputBox" Height="34" VerticalContentAlignment="Center" BorderThickness="1"
                                         KeyDown="InputBox_KeyDown" Margin="0,0,8,0"
                                         FontSize="14" Padding="8,0"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 桌面头像模式：只保留角色头像和最近一条角色消息。 -->
        <Grid x:Name="CompactModePanel" Visibility="Collapsed"
              MouseLeftButtonDown="CompactModePanel_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="CompactAvatarBorder" Width="64" Height="64"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                    CornerRadius="32" BorderThickness="2.5" Background="#F8FFFFFF"
                    BorderBrush="#E0B06A30" ToolTip="双击恢复完整聊天窗口">
                <TextBlock x:Name="CompactAvatarText" Text="🍑" FontSize="32"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="CompactBubbleBorder" Grid.Column="1" Margin="4,4,4,19"
                    Padding="11,9,9,9" CornerRadius="15" Background="#FFFFFFFF"
                    BorderBrush="#E0B06A30" BorderThickness="1.5" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,3">
                        <Button DockPanel.Dock="Right" Content="—" Width="24" Height="22"
                                Click="HideWindow_Click" Background="Transparent" BorderThickness="0"
                                FontSize="12" Cursor="Hand" ToolTip="完全隐藏到系统托盘"/>
                        <Button DockPanel.Dock="Right" Content="□" Width="24" Height="22"
                                Click="FullMode_Click" Background="Transparent" BorderThickness="0"
                                FontSize="12" Cursor="Hand" ToolTip="恢复完整聊天窗口"/>
                        <TextBlock x:Name="CompactCharacterName" Text="胡桃" FontSize="11"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="CompactBubbleText" Grid.Row="1"
                               Text="我在这里哦~" FontSize="13" LineHeight="18"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="54" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 角色选择面板：Popup 独立于滚动区，点击窗口外自动关闭。 -->
        <Popup x:Name="CharacterPickerPopup"
               PlacementTarget="{Binding ElementName=SwitchButton}"
               Placement="Bottom" HorizontalOffset="-238" VerticalOffset="8"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border x:Name="CharacterPickerBorder" Width="278" Padding="12"
                    Background="#FCFFFFFF" BorderBrush="#E0B06A30" BorderThickness="1.5"
                    CornerRadius="16">
                <Border.Resources>
                    <Style x:Key="CharacterOptionButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#16000000"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="9,8"/>
                        <Setter Property="Margin" Value="0,0,0,7"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="OptionCard" Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="OptionCard" Property="Opacity" Value="0.78"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="OptionCard" Property="Opacity" Value="0.58"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.24" Color="#50301D"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="CharacterPickerTitle" Text="选择陪伴角色"
                               FontWeight="Bold" FontSize="15" Foreground="#7A3F16"
                               Margin="4,1,4,2"/>
                    <TextBlock Text="人设、声线与聊天记录相互独立"
                               FontSize="11" Foreground="#88796E" Margin="4,0,4,9"/>
                    <StackPanel x:Name="CharacterPickerPanel"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
