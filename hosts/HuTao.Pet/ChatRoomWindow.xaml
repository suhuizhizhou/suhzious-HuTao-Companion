<Window x:Class="HuTao.Pet.ChatRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聊天室" Height="620" Width="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="False" ShowInTaskbar="True" ResizeMode="CanResizeWithGrip"
        MinHeight="420" MinWidth="440">
    <Grid>
        <Border x:Name="ShellBorder" Background="#FAFFFFFF" CornerRadius="18"
                BorderBrush="#E0B06A30" BorderThickness="2.5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border x:Name="TitleBarBorder" Grid.Row="0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        Background="#40B06A30" CornerRadius="16,16,0,0" Padding="12,9">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Width="27" Height="28"
                                Click="Close_Click" Background="Transparent" BorderThickness="0"
                                Foreground="#6B4A34" FontSize="14" Cursor="Hand" ToolTip="关闭聊天室"/>
                        <Button x:Name="DebugButton" DockPanel.Dock="Right" Content="🐞" Width="28" Height="28"
                                Click="Debug_Click" Background="Transparent" BorderThickness="0"
                                Foreground="#6B4A34" FontSize="13" Cursor="Hand"
                                ToolTip="显示/隐藏导演调度信息（排查用，正常聊天不需要看）"/>
                        <Button x:Name="AutoButton" DockPanel.Dock="Right" Content="▶" Width="28" Height="28"
                                Click="Auto_Click" Background="Transparent" BorderThickness="0"
                                Foreground="#6B4A34" FontSize="13" Cursor="Hand"
                                ToolTip="自动对谈：让角色们自己聊下去"/>
                        <StackPanel>
                            <TextBlock x:Name="TitleText" Text="聊天室" FontWeight="Bold" FontSize="14"
                                       Foreground="#5A3A26" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SubtitleText" Text="旁观中" FontSize="10.5"
                                       Foreground="#96826F" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 在场角色 -->
                <Border Grid.Row="1" x:Name="RosterBorder" Padding="12,7" Background="#0C000000">
                    <StackPanel x:Name="RosterPanel" Orientation="Horizontal"/>
                </Border>

                <!-- 对话记录 -->
                <ScrollViewer Grid.Row="2" x:Name="TranscriptScroll"
                              VerticalScrollBarVisibility="Auto" Padding="12,8">
                    <StackPanel x:Name="TranscriptPanel"/>
                </ScrollViewer>

                <!-- 导演调度信息（默认折叠：聊天室要沉浸，调度是作者视角的东西） -->
                <Border Grid.Row="3" x:Name="DebugBorder" Visibility="Collapsed"
                        Padding="12,6" Background="#0F000000">
                    <TextBlock x:Name="DebugText" FontSize="10.5" Foreground="#7A6A5C"
                               TextWrapping="Wrap" MaxHeight="70"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- 输入区：用户默认旁观，想说话随时插。 -->
                <Border Grid.Row="4" Padding="12,4,12,12">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Visibility="Collapsed"
                                   FontSize="10.5" Foreground="#96755A" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" Margin="2,0,2,4"
                                   ToolTip="系统提示，不属于角色台词"/>
                        <DockPanel>
                            <Button x:Name="StepButton" DockPanel.Dock="Right" Content="插话" Width="62" Height="34"
                                    Click="Step_Click" Background="#8C6032" Foreground="White"
                                    BorderThickness="0" FontWeight="Bold" Cursor="Hand"
                                    ToolTip="把这句话说给她们，然后让一位角色回应"/>
                            <Button x:Name="NextButton" DockPanel.Dock="Right" Content="▸" Width="34" Height="34"
                                    Click="Next_Click" Margin="0,0,8,0" Background="#1A000000"
                                    BorderThickness="0" FontSize="14" Cursor="Hand"
                                    ToolTip="不说话，只让下一位角色接一句"/>
                            <TextBox x:Name="InputBox" Height="34" VerticalContentAlignment="Center"
                                     BorderThickness="1" KeyDown="InputBox_KeyDown"
                                     FontSize="14" Padding="8,0"
                                     ToolTip="默认旁观；打字回车即可插话"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
