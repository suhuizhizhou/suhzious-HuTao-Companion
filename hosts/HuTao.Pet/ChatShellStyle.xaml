<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
      QQNT 风格的聊天客户端主题令牌。

      规矩：**UI 代码里不许出现硬编码颜色**。这个项目的既有做法是把视觉收进
      CharacterThemeCatalog / 资源字典（见 MainWindow.xaml 的写法），
      这样换主题、做对比度调整都只改一处。

      色值取 QQNT 的观感：浅灰侧栏 + 更浅的消息区 + 低饱和文字层级 + 一个醒目的红色角标。
    -->

    <!-- ── 底色 ──────────────────────────────────────────────────────── -->
    <Color x:Key="ChatShell.WindowBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="ChatShell.SidebarBackgroundColor">#FFF2F2F2</Color>
    <Color x:Key="ChatShell.MessageAreaBackgroundColor">#FFF5F5F5</Color>
    <Color x:Key="ChatShell.TitleBarBackgroundColor">#FFF7F7F7</Color>

    <SolidColorBrush x:Key="ChatShell.WindowBackground" Color="{StaticResource ChatShell.WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="ChatShell.SidebarBackground" Color="{StaticResource ChatShell.SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="ChatShell.MessageAreaBackground" Color="{StaticResource ChatShell.MessageAreaBackgroundColor}"/>
    <SolidColorBrush x:Key="ChatShell.TitleBarBackground" Color="{StaticResource ChatShell.TitleBarBackgroundColor}"/>

    <!-- ── 交互态 ────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ChatShell.SessionHover" Color="#0A000000"/>
    <SolidColorBrush x:Key="ChatShell.SessionSelected" Color="#14000000"/>
    <SolidColorBrush x:Key="ChatShell.Divider" Color="#FFE5E5E5"/>
    <SolidColorBrush x:Key="ChatShell.IconHover" Color="#0F000000"/>
    <SolidColorBrush x:Key="ChatShell.SearchBackground" Color="#FFE8E8E8"/>

    <!-- ── 文字层级 ──────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ChatShell.TextPrimary" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="ChatShell.TextSecondary" Color="#FF4A4A4A"/>
    <SolidColorBrush x:Key="ChatShell.TextMuted" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="ChatShell.TextFaint" Color="#FFB0B0B0"/>
    <SolidColorBrush x:Key="ChatShell.TextOnAccent" Color="#FFFFFFFF"/>

    <!-- ── 角标与气泡 ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ChatShell.Badge" Color="#FFFF3B30"/>
    <SolidColorBrush x:Key="ChatShell.BadgeMuted" Color="#FFC0C0C0"/>
    <SolidColorBrush x:Key="ChatShell.BubbleIncoming" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ChatShell.BubbleOutgoing" Color="#FFE08A3C"/>
    <SolidColorBrush x:Key="ChatShell.SystemText" Color="#FF9A9A9A"/>

    <!-- ── 尺寸 ──────────────────────────────────────────────────────── -->
    <sys:Double x:Key="ChatShell.TitleBarHeight">40</sys:Double>
    <sys:Double x:Key="ChatShell.SidebarWidth">280</sys:Double>
    <sys:Double x:Key="ChatShell.SidebarCollapsedWidth">64</sys:Double>
    <sys:Double x:Key="ChatShell.SessionRowHeight">62</sys:Double>
    <sys:Double x:Key="ChatShell.SessionAvatarSize">40</sys:Double>
    <sys:Double x:Key="ChatShell.MessageAvatarSize">36</sys:Double>
    <sys:Double x:Key="ChatShell.ComposerHeight">44</sys:Double>

    <!-- ── 字体 ──────────────────────────────────────────────────────── -->
    <FontFamily x:Key="ChatShell.FontFamily">Microsoft YaHei UI</FontFamily>

    <!-- ── 标题栏按钮：透明底、悬停浅灰、24×24 图标位 ──────────────────── -->
    <Style x:Key="ChatShellIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource ChatShell.TextSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{StaticResource ChatShell.IconHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.6"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 关闭按钮：悬停变红，与 Windows 惯例一致 ─────────────────────── -->
    <Style x:Key="ChatShellCloseButtonStyle" TargetType="Button"
           BasedOn="{StaticResource ChatShellIconButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FFE81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      ── 会话行 ─────────────────────────────────────────────────────────
      62px 高、选中时左侧 3px accent 竖条、右对齐的角标槽。
      竖条的画刷由行模板的 Tag（该会话的 accent）绑定进来；没给就用中性灰。
    -->
    <Style x:Key="ChatShellSessionRowStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Height="{StaticResource ChatShell.SessionRowHeight}">
                        <Border x:Name="RowBackground" Background="{TemplateBinding Background}"/>
                        <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                Visibility="Collapsed"/>
                        <ContentPresenter Margin="12,0,10,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBackground" Property="Background"
                                    Value="{StaticResource ChatShell.SessionHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBackground" Property="Background"
                                    Value="{StaticResource ChatShell.SessionSelected}"/>
                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 搜索结果/群成员卡片：圆角 + 悬停微亮，与桌宠的角色卡视觉同源 -->
    <Style x:Key="ChatShellCardButtonStyle" TargetType="Button">        <Setter Property="Background" Value="#08FFFFFF"/>
        <Setter Property="BorderBrush" Value="#22000000"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Card" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Card" Property="Opacity" Value="0.58"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 输入框：单行圆角，聚焦时描边换成会话 accent（由宿主设置 BorderBrush） -->
    <Style x:Key="ChatShellInputStyle" TargetType="TextBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource ChatShell.FontFamily}"/>
        <Setter Property="Foreground" Value="{StaticResource ChatShell.TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource ChatShell.TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      「＋」细轨按钮：默认几乎隐形，鼠标悬停/展开时才显形。
      刻意做得轻——它只是抽屉的开关，不该和新消息抢注意力。
    -->
    <Style x:Key="ChatShellRailButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ChatShell.TextMuted}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="8"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{StaticResource ChatShell.SearchBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource ChatShell.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
