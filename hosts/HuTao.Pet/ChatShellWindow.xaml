<Window x:Class="HuTao.Pet.ChatShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:HuTao.Pet.ChatShell"
        Title="聊天" Height="640" Width="960"
        MinHeight="480" MinWidth="720"
        WindowStyle="None" AllowsTransparency="False" Background="White"
        ResizeMode="CanResize" ShowInTaskbar="True"
        FontFamily="{DynamicResource ChatShell.FontFamily}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Foreground="{DynamicResource ChatShell.TextPrimary}">
    <Window.Resources>
        <shell:ArgbToBrushConverter x:Key="ArgbToBrush"/>
        <!--
          会话右键菜单放在资源里，不放进可视树：ContextMenu 一旦有了逻辑父级
          就会抛「不能有逻辑或视觉父级」，XAML 加载阶段直接崩（踩过一次）。
        -->
        <ContextMenu x:Key="SessionMenuResource" x:Shared="False">
            <MenuItem Header="置顶会话" Tag="Pin" Click="SessionMenu_Click"/>
            <MenuItem Header="消息免打扰" Tag="Mute" Click="SessionMenu_Click"/>
            <MenuItem Header="标记已读" Tag="MarkRead" Click="SessionMenu_Click"/>
            <Separator/>
            <MenuItem Header="重命名…" Tag="Rename" Click="SessionMenu_Click"/>
            <MenuItem Header="管理成员…" Tag="Members" Click="SessionMenu_Click"/>
            <Separator/>
            <MenuItem Header="清空聊天记录" Tag="Clear" Click="SessionMenu_Click"/>
            <MenuItem Header="删除会话" Tag="Delete" Click="SessionMenu_Click"/>
        </ContextMenu>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 标题栏（整条可拖、双击最大化）──────────────────────────── -->
        <Border x:Name="TitleBar" Grid.Row="0"
                Height="{DynamicResource ChatShell.TitleBarHeight}"
                Background="{DynamicResource ChatShell.TitleBarBackground}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel LastChildFill="True">
                <!-- 窗口按钮 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button x:Name="MinimizeButton" Content="—"
                            Style="{DynamicResource ChatShellIconButtonStyle}"
                            Click="Minimize_Click" ToolTip="最小化"/>
                    <Button x:Name="MaximizeButton" Content="▢"
                            Style="{DynamicResource ChatShellIconButtonStyle}"
                            Click="Maximize_Click" ToolTip="最大化 / 还原"/>
                    <Button x:Name="CloseButton" Content="✕"
                            Style="{DynamicResource ChatShellCloseButtonStyle}"
                            Click="Close_Click" ToolTip="关闭聊天"/>
                </StackPanel>

                <!-- 会话信息 + 操作 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="AutoTalkButton" Content="▶" Visibility="Collapsed"
                            Style="{DynamicResource ChatShellIconButtonStyle}"
                            Click="AutoTalk_Click" ToolTip="自动对谈：让角色们自己聊下去"/>
                    <Button x:Name="StepButton" Content="▸" Visibility="Collapsed"
                            Style="{DynamicResource ChatShellIconButtonStyle}"
                            Click="Step_Click" ToolTip="不说话，只让下一位角色接一句"/>
                    <Button x:Name="DebugButton" Content="🐞" Visibility="Collapsed"
                            Style="{DynamicResource ChatShellIconButtonStyle}"
                            Click="Debug_Click" ToolTip="显示/隐藏导演调度信息（排查用）"/>
                    <Button x:Name="ClearButton" Content="🗑"
                            Style="{DynamicResource ChatShellIconButtonStyle}"
                            Click="ClearHistory_Click" ToolTip="清空当前会话的聊天记录"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="TitleText" Text="聊天" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubtitleText" Text="选择左侧会话说点什么"
                               FontSize="10.5" Foreground="{DynamicResource ChatShell.TextMuted}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── 主体：细轨 + 侧栏 + 分割条 + 消息区 ─────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 细轨：只有 ＋。点它才展开抽屉（像小程序那样，默认不占版面） -->
            <Border Grid.Column="0" Width="44"
                    Background="{DynamicResource ChatShell.SidebarBackground}"
                    BorderBrush="{DynamicResource ChatShell.Divider}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top" Margin="0,10,0,0">
                    <Button x:Name="RailToggleButton" Content="＋"
                            Width="32" Height="32" Margin="6,0,6,0"
                            Style="{DynamicResource ChatShellRailButtonStyle}"
                            ToolTip="更多功能（桌宠面板、角色、朗读、显示模式…）"
                            Click="RailToggle_Click"/>
                </StackPanel>
            </Border>

        <Grid Grid.Column="1" x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="200" MaxWidth="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧栏 -->
            <Border Grid.Column="0" Background="{DynamicResource ChatShell.SidebarBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索 + 发起群聊 -->
                    <StackPanel Grid.Row="0" Margin="10,10,10,6">
                        <Border Background="{DynamicResource ChatShell.SearchBackground}"
                                CornerRadius="6" Height="30" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="🔍 搜索会话…" FontSize="12.5" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource ChatShell.TextMuted}"
                                           x:Name="SearchPlaceholder" IsHitTestVisible="False"/>
                                <TextBox x:Name="SearchBox" Style="{DynamicResource ChatShellInputStyle}"
                                         FontSize="12.5" TextChanged="SearchBox_TextChanged"
                                         Background="Transparent" BorderThickness="0"/>
                            </Grid>
                        </Border>
                        <Button x:Name="NewGroupButton" Content="＋ 发起群聊"
                                Style="{DynamicResource ChatShellCardButtonStyle}"
                                HorizontalContentAlignment="Center" FontSize="12.5"
                                Click="NewGroup_Click"/>
                    </StackPanel>

                    <!-- 会话列表 -->
                    <ListBox x:Name="SessionList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{DynamicResource ChatShellSessionRowStyle}"
                             SelectionChanged="SessionList_SelectionChanged"
                             MouseRightButtonUp="SessionList_MouseRightButtonUp"
                             KeyDown="SessionList_KeyDown"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl x:Name="AvatarHost" Grid.Column="0"
                                                    VerticalAlignment="Center" Loaded="SessionAvatar_Loaded"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="SessionTitle" Text="{Binding Title}"
                                                   FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="SessionPreview" Text="{Binding Preview}"
                                                   FontSize="12.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource ChatShell.TextMuted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <TextBlock x:Name="SessionTime" Text="{Binding TimeLabel}"
                                                   FontSize="11" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource ChatShell.TextFaint}"/>
                                        <ContentControl x:Name="BadgeHost" Margin="0,5,0,0"
                                                        HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空态 -->
                    <TextBlock x:Name="SidebarEmpty" Grid.Row="1" Text="没有匹配的会话"
                               FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource ChatShell.TextMuted}"
                               Visibility="Collapsed"/>

                    <!-- 底部：用户条目 -->
                    <Border Grid.Row="2" Padding="12,10" Background="#08000000">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15"
                                    Background="#22000000" Margin="0,0,8,0">
                                <TextBlock Text="👤" FontSize="15" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="你" FontSize="13" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource ChatShell.Divider}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE"/>

            <!-- 消息区 -->
            <Grid Grid.Column="2" Background="{DynamicResource ChatShell.MessageAreaBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 会话头：成员一览 + 在场状态 -->
                <Border Grid.Row="0" Height="48" Padding="16,0"
                        Background="{DynamicResource ChatShell.TitleBarBackground}"
                        BorderBrush="{DynamicResource ChatShell.Divider}" BorderThickness="0,0,0,1">
                    <DockPanel VerticalAlignment="Center">
                        <StackPanel x:Name="MemberStrip" DockPanel.Dock="Right"
                                    Orientation="Horizontal" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MemberSummary" FontSize="12"
                                   Foreground="{DynamicResource ChatShell.TextMuted}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <!-- 消息 -->
                <ScrollViewer x:Name="MessageScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" Padding="16,10">
                    <StackPanel>
                        <StackPanel x:Name="MessagePanel"/>
                        <!--
                          「正在输入」占位。原版桌宠在等模型回答时显示一个 thinking 气泡；
                          没有它，用户会以为自己的消息被吞了——角色回复要好几秒。
                          它是**界面临时元素**，不进消息集合、不落盘。
                        -->
                        <Border x:Name="AwaitingBubble" Visibility="Collapsed"
                                HorizontalAlignment="Left" Margin="0,4,0,10"
                                Background="{DynamicResource ChatShell.BubbleIncoming}"
                                CornerRadius="10" Padding="12,9" MaxWidth="360">
                            <TextBlock Text="正在输入…" FontSize="12.5"
                                       Foreground="{DynamicResource ChatShell.TextMuted}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 骨架屏：激活耗时超过 150ms 才出现，避免白屏 -->
                <Border x:Name="Skeleton" Grid.Row="1" Visibility="Collapsed"
                        Background="{DynamicResource ChatShell.MessageAreaBackground}">
                    <StackPanel Margin="16,16,16,0">
                        <Border Height="40" Width="220" CornerRadius="10"
                                Background="#14000000" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <Border Height="40" Width="300" CornerRadius="10"
                                Background="#14000000" HorizontalAlignment="Right" Margin="0,0,0,12"/>
                        <Border Height="40" Width="180" CornerRadius="10"
                                Background="#14000000" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- 导演调度信息（默认折叠：那是作者视角的东西） -->
                <Border x:Name="DebugBorder" Grid.Row="2" Visibility="Collapsed"
                        Padding="16,6" Background="#0F000000">
                    <TextBlock x:Name="DebugText" FontSize="10.5"
                               Foreground="{DynamicResource ChatShell.TextSecondary}"
                               TextWrapping="Wrap" MaxHeight="70" TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- 输入区 -->
                <Border Grid.Row="3" Padding="16,6,16,12"
                        Background="{DynamicResource ChatShell.MessageAreaBackground}">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Visibility="Collapsed"
                                   FontSize="10.5" Foreground="#96755A" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" Margin="2,0,2,4"
                                   ToolTip="系统提示，不属于角色台词"/>
                        <DockPanel>
                            <Button x:Name="SendButton" DockPanel.Dock="Right" Content="发送"
                                    Width="72" Height="34" Margin="8,0,0,0"
                                    Background="{DynamicResource ChatShell.BubbleOutgoing}"
                                    Foreground="White" BorderThickness="0"
                                    FontWeight="SemiBold" Cursor="Hand" Click="Send_Click" IsEnabled="False"
                                    AutomationProperties.Name="发送消息"/>
                            <Border Background="White" CornerRadius="6"
                                    BorderBrush="{DynamicResource ChatShell.Divider}" BorderThickness="1"
                                    MinHeight="{DynamicResource ChatShell.ComposerHeight}" MaxHeight="120">
                                <TextBox x:Name="InputBox" Style="{DynamicResource ChatShellInputStyle}"
                                         PreviewKeyDown="InputBox_KeyDown" AcceptsReturn="True"
                                         TextChanged="InputBox_TextChanged" TextWrapping="Wrap"
                                         MinHeight="{DynamicResource ChatShell.ComposerHeight}" MaxHeight="118"
                                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="消息输入框"
                                         ToolTip="Enter 发送，Shift+Enter 换行"/>
                            </Border>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

            <!-- 抽屉内容：浮在主区之上，不挤压布局 -->
            <Border x:Name="RailDrawer" Grid.Column="1" Width="248"
                    HorizontalAlignment="Left" Visibility="Collapsed"
                    Background="{DynamicResource ChatShell.SidebarBackground}"
                    BorderBrush="{DynamicResource ChatShell.Divider}" BorderThickness="0,0,1,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" Direction="0"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="14,12,8,8">
                        <Button x:Name="RailCloseButton" DockPanel.Dock="Right" Content="✕"
                                Width="24" Height="24" BorderThickness="0" Cursor="Hand"
                                Background="Transparent"
                                Foreground="{DynamicResource ChatShell.TextMuted}"
                                Click="RailClose_Click"/>
                        <TextBlock Text="桌宠面板" FontSize="13.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ChatShell.TextPrimary}"/>
                    </DockPanel>

                    <ListBox x:Name="RailToolList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="6,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Chrome" Background="Transparent"
                                                    CornerRadius="6" Padding="8,7">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background"
                                                            Value="{DynamicResource ChatShell.SearchBackground}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15"
                                               Width="24" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding Label}" FontSize="12.5"
                                                   Foreground="{DynamicResource ChatShell.TextPrimary}"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource ChatShell.TextMuted}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="RailHint" Grid.Row="2" Margin="14,6,14,12"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource ChatShell.TextMuted}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 会话右键菜单见 Window.Resources 的 SessionMenuResource -->
    </Grid>
</Window>
