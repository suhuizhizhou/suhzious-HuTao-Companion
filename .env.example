# 胡桃 AI 桌宠 · 环境变量示例
# 复制为 .env 或直接设置到系统环境变量后使用。

# DeepSeek LLM（Agent 用）：设置后 Agent 自动从 Mock 切换为真实对话
DEEPSEEK_API_KEY=

# 可选覆盖
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 语音合成（GPT-SoVITS）：venv 的 python 路径，Agent 接入真实 TTS 时用
# HU_TAO_TTS_PYTHON=voice/.venv/Scripts/python.exe
