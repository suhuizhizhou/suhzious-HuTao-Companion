# 胡桃 AI 桌宠 · 环境变量示例
# 复制为 .env 或直接设置到系统环境变量后使用。

# DeepSeek LLM（Agent 用）：设置后 Agent 自动从 Mock 切换为真实对话
DEEPSEEK_API_KEY=

# 可选覆盖
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 前台应用感知，默认开启。开启后读取当前前台应用的进程名、窗口标题和停留时长，
# 让角色知道用户此刻在做什么。不截图、不读文件、不枚举后台进程。
# 也可以在桌宠标题栏通过圆点按钮随时开启/关闭。
# 显式设为 false / 0 / no 才会关闭：
# HU_TAO_ALLOW_APP_AWARENESS=true

# 沉浸闸门：保证聊天窗口里不出现任何出戏内容。
# HU_TAO_IMMERSION=off            # 整体关闭两层闸门（不推荐）
# HU_TAO_IMMERSION_CRITIC=false   # 只保留零延迟的规则层，省掉每轮一次评审调用
# HU_TAO_IMMERSION_REPAIR=false   # 禁止模型重写，违规直接退角色兜底台词

# 长期记忆：历史检索（零 LLM 成本）+ 时间有效性 + 空闲后台提炼。
# HU_TAO_MEMORY=off               # 整体关闭记忆层
# HU_TAO_MEMORY_CONSOLIDATE=false # 只关后台提炼，保留检索
# HU_TAO_MEMORY_HALFLIFE_DAYS=7   # 新鲜度半衰期；调大 = 更看重久远的往事

# 完整 Release 自动使用 voice/python/python.exe，无需设置此项。
# 开发环境可用此项覆盖 GPT-SoVITS Python 路径：
# HU_TAO_TTS_PYTHON=voice/.venv/Scripts/python.exe

# TTS 进程模式：resident（默认，模型常驻显存）/ on-demand（每句重新启动进程）
# HU_TAO_TTS_MODE=resident
# 常驻服务地址；不要与手动启动的 GPT-SoVITS api_v2.py 使用同一端口
# HU_TAO_TTS_URL=http://127.0.0.1:9881/
# 常驻服务设备：cuda / cpu；half=false 可关闭半精度
# HU_TAO_TTS_DEVICE=cuda
# HU_TAO_TTS_HALF=true

# 可选：本机剧情语义检索服务。未配置时使用无需模型的 BM25 + 角色记忆检索。
# 服务需先单独启动；模型和向量索引的生成、启动命令见 docs/story-rag.md。
# 仅接受本机 HTTP；不可用时降级为轻量检索。并非 GPT-SoVITS 的端口。
# HU_TAO_STORY_SEMANTIC_URL=http://127.0.0.1:9891/

# 可读后端日志（BackendTrace）：默认开启，记录 agent + RAG 一轮到底做了什么，
# 含用户输入、召回到的原文、草稿与最终答复。**只写本机**，不进角色历史、不进任何对外通道。
# 默认位置 %LOCALAPPDATA%\HuTaoCompanion\logs\backend-trace.log（宿主启动会打印路径）。
# 与 runtime.log 的分工：那份是给机器看的崩溃诊断（不含正文），这份是给人看的回合叙事。
# HU_TAO_TRACE=off                 # 整体关闭（不需要复盘时关掉更省磁盘）
# HU_TAO_TRACE_PATH=D:\logs\trace.log
# HU_TAO_TRACE_EVIDENCE=3          # 每次 RAG 调用打印几条证据
# HU_TAO_TRACE_MAX_MB=8            # 单文件上限，超过轮转为 .1
