{"chapter_id":"main-quest-72237","main_id":72237,"main_title":"安提戈努斯","main_description":"在悬空牢知道了一些故事，你决定前去寻找…","chapter_title":"安提戈努斯","chapter_number":"","subquest_index":0,"subquest_id":7223703,"subquest_title":"","talk_id":7223703,"sequence":11,"variant":0,"line_id":722370312,"next_line_ids":[722370313],"speaker_type":"TALK_ROLE_NPC","speaker_id":1005,"speaker_text_hash":1356475093,"speaker":"派蒙","speaker_raw":"派蒙","text_hash":2453700538,"text":"白夜国的地走官可真厉害啊…","raw_text":"白夜国的地走官可真厉害啊…","resolved":true,"source_file":"BinOutput/Talk/Quest/7223703.json"}
