{"chapter_id":"main-quest-23005","main_id":23005,"main_title":"吞金和蓄财","main_description":"哈特姆的期货交易日已经到了，不知道他的收获如何呢？","chapter_title":"吞金和蓄财","chapter_number":"","subquest_index":2,"subquest_id":2300504,"subquest_title":"","talk_id":2300504,"sequence":22,"variant":0,"line_id":230050424,"next_line_ids":[],"speaker_type":"TALK_ROLE_NPC","speaker_id":4004,"speaker_text_hash":1566259984,"speaker":"哈特姆","speaker_raw":"哈特姆","text_hash":3653082666,"text":"拜托了，请为我准备一份苹果酿吧！","raw_text":"拜托了，请为我准备一份苹果酿吧！","resolved":true,"source_file":"BinOutput/Talk/Quest/2300504.json"}
