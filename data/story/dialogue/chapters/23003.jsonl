{"chapter_id":"main-quest-23003","main_id":23003,"main_title":"吞金和蓄财","main_description":"哈特姆的期货交易日已经到了，不知道他的收获如何呢？","chapter_title":"吞金和蓄财","chapter_number":"","subquest_index":0,"subquest_id":2300302,"subquest_title":"","talk_id":2300302,"sequence":0,"variant":0,"line_id":230030201,"next_line_ids":[230030202],"speaker_type":"TALK_ROLE_NPC","speaker_id":4004,"speaker_text_hash":1566259984,"speaker":"哈特姆","speaker_raw":"哈特姆","text_hash":1054776306,"text":"旅行者！啊不对，财富之子，幸运之人！你来了！","raw_text":"旅行者！啊不对，财富之子，幸运之人！你来了！","resolved":true,"source_file":"BinOutput/Talk/Quest/2300302.json"}
